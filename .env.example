ARSUNE_DATABASE_URL=postgresql+psycopg://arsune:arsune@127.0.0.1:55432/arsune
ARSUNE_REDIS_URL=redis://127.0.0.1:56379/0
ARSUNE_EVIDENCE_DIR=.data/evidence
ARSUNE_DEMO_URL=http://127.0.0.1:8541
ARSUNE_MODEL_BASE_URL=
ARSUNE_MODEL_API_KEY=
ARSUNE_MODEL_NAME=
# Thinking models spend thinking tokens inside this cap; raise it for them (max 4096)
ARSUNE_MODEL_MAX_OUTPUT_TOKENS=1800
# Optional (0-2). Leave unset for models that accept only the default temperature
ARSUNE_MODEL_TEMPERATURE=
ARSUNE_MODEL_COST_CEILING_USD=0.25
ARSUNE_MODEL_INPUT_USD_PER_MILLION=
ARSUNE_MODEL_OUTPUT_USD_PER_MILLION=
# Settlement: "dry" moves no money; "near_intents" settles USDC on NEAR mainnet (docs/SETTLEMENT.md)
ARSUNE_SETTLEMENT_MODE=dry
ARSUNE_NEAR_ACCOUNT_ID=
ARSUNE_NEAR_PRIVATE_KEY=
ARSUNE_NEAR_RPC_URL=https://free.rpc.fastnear.com
ARSUNE_INTENTS_CONTRACT=intents.near
ARSUNE_BOUNTY_TOKEN=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
ARSUNE_MAX_PAYMENT_AMOUNT=1000000
ARSUNE_SWARM_ACCOUNTS_FILE=.data/swarm-accounts.json
ARSUNE_OWNER_SESSION_SECRET=
